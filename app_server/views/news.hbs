<!DOCTYPE html>
<!-- Website template by freewebsitetemplates.com -->
<html>
<head>
	<meta charset="UTF-8">
	<title>{{title}}</title>
	<link rel="stylesheet" href="css/style.css" type="text/css">
</head>
<body>
	<div id="background">
		<div id="page">
			{{> header isSelected="news"}}
			<div id="contents">
				<div class="box">
					<div>
						<div id="news" class="body">
							{{#with newsData}}
							<div class="sidebar">
								<h3>{{latest.title}}</h3>
								<ul>
									{{#each latest.subtitles}}
									<li>
										<a href="/news">{{this}}</a>
									</li>
									{{/each}}
								</ul>
								<h3>{{tips.title}}</h3>
								<ul>
									{{#each tips.subtitles}}
									<li>
										<a href="/news">{{this}}</a>
									</li>
									{{/each}}
								</ul>
							</div>
							<div>
								<h1>News</h1>
								<img src="images/{{article.image}}" alt="Img">
								<h2>{{article.title}}</h2>
								<span class="time">{{article.date}}<br> by: {{article.author}}</span>
								{{{article.content}}}
							</div>
							{{/with}}
						</div>
					</div>
				</div>
			</div>
		</div>
		{{> footer isSelected="news"}}
	</div>
</body>
</html>